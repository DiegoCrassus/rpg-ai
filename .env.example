# Copy to .env — never commit .env

# Repository MCP + gh CLI (GitHub provider)
GITHUB_PERSONAL_ACCESS_TOKEN_CLASSIC=
REPOSITORY_SLUG=DiegoCrassus/rpg-ai
# Legacy alias:
GITHUB_REPOSITORY=DiegoCrassus/rpg-ai

# Board MCP — workspace RPG-AI, project RPG (Plane provider)
PLANE_API_KEY=
BOARD_WORKSPACE_SLUG=RPG-AI
PLANE_WORKSPACE_SLUG=RPG-AI
BOARD_PROJECT_ID=
PLANE_PROJECT_ID=

# Supabase — local: run `make supabase-start` and copy CLI output
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Frontend dev origins (Vite default port 5173 — include both loopback forms)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Deep Agent / OpenAI — SDLC agents + Sheet Import Agent (LangChain deepagents)
AGENT_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
